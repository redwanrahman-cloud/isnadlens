OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# GPT-5.6 requests explicitly use low reasoning; Terra confirms conflicts/invalid citations.
ISNADLENS_PAID_CALLS_AUTHORIZED=false
ISNADLENS_MAX_SPEND_USD=0
ISNADLENS_MAX_CALLS=20
# Opt in only with an authorized prepaid provider account. Keeps the ledger and
# traffic protections, but replaces app cash/lifetime-call caps with provider credit.
ISNADLENS_PROVIDER_CREDIT_ONLY=false
# Optional Google natural speech: use a free-tier project with no paid billing linked.
# For local setup, the same settings may be saved in ignored artifacts/private/google-speech.env.
GEMINI_API_KEY=
ISNADLENS_GOOGLE_FREE_TIER_CONFIRMED=false
